# ================================
# CONFIGURAÇÃO GERAL DO SISTEMA
# ================================

# Ambiente de execução
NODE_ENV=production
PORT=3000

# ================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ================================

# MySQL (Banco Principal)
DB_HOST=mysql
DB_PORT=3306
DB_ROOT_PASSWORD=rootpassword123
DB_NAME=gerenciador_financeiro
DB_USER=gf_user
DB_PASSWORD=gf_password123

# Para conexão da API (usar DB_USER/DB_PASSWORD)
DB_USERNAME=gf_user
DB_DATABASE=gerenciador_financeiro

# MongoDB (Logs e Analytics)  
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adminpassword123
MONGO_DB=gerenciador_logs
MONGO_URI=mongodb://admin:adminpassword123@mongodb:27017/gerenciador_logs?authSource=admin

# ================================
# CONFIGURAÇÃO JWT
# ================================

# Chaves JWT (ALTERAR EM PRODUÇÃO!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production-min-32-chars

# Tempo de expiração
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ================================
# CONFIGURAÇÃO DE SEGURANÇA
# ================================

# CORS Origins (separado por vírgula)
CORS_ORIGIN=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Hash rounds para bcrypt
BCRYPT_ROUNDS=12

# ================================
# CONFIGURAÇÃO DE FEATURES
# ================================

# Habilitar Swagger (apenas desenvolvimento)
ENABLE_SWAGGER=false

# Logging level
LOG_LEVEL=info

# Habilitar logs detalhados
ENABLE_DETAILED_LOGS=true

# Comprovantes (S3 + IA)
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=gerenciador-financeiro-comprovantes
AWS_S3_ACCESS_KEY_ID=your-access-key-id
AWS_S3_SECRET_ACCESS_KEY=your-secret-access-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
MOVIMENTO_COMPROVANTE_MAX_SIZE_BYTES=10485760

# WhatsApp Cloud API + worker MySQL
# Consulte no deploy uma versao Graph suportada; nao mantenha vXX.X.
WHATSAPP_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate-a-random-webhook-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_MEDIA_MAX_SIZE_BYTES=10485760
WHATSAPP_HTTP_TIMEOUT_MS=15000
WHATSAPP_WORKER_ENABLED=true
WHATSAPP_WORKER_POLL_INTERVAL_MS=1000
WHATSAPP_WORKER_LEASE_SECONDS=300

# ================================
# CONFIGURAÇÃO ESPECÍFICA DOCKER
# ================================

# Timezone
TZ=America/Sao_Paulo

# User IDs para containers
PUID=1001
PGID=1001

# ================================
# CONFIGURAÇÃO DE MONITORAMENTO
# ================================

# Health Check
HEALTH_CHECK_ENABLED=true

# ================================
# OBSERVAÇÕES IMPORTANTES
# ================================

# 1. SEMPRE altere as senhas padrão em produção!
# 2. Mantenha as chaves JWT seguras e rotacione regularmente
# 3. Use HTTPS em produção
# 4. Configure backup do banco de dados
# 5. Monitore logs e métricas regularmente

# ================================
# EXEMPLO DE USO
# ================================

# Para usar este arquivo:
# 1. Copie para .env na raiz do projeto: cp .env.example .env
# 2. Edite as variáveis conforme sua necessidade
# 3. Execute: docker-compose up -d